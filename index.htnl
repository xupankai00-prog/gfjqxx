<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>广丰金桥学校 - 宏博德坚 毅行致远</title>
    <meta name="description" content="上饶市广丰区金桥学校，全封闭寄宿制高级中学，中国美术学院生源基地校，特色办学、小班化教学。">
    <link rel="icon" href="images/logo.png" type="image/png">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;700&family=Noto+Serif+SC:wght@600;700&display=swap" rel="stylesheet">

    <style>
        /* ===== 基础重置与变量 ===== */
        * { margin: 0; padding: 0; box-sizing: border-box; }

        :root {
            --primary: #0b3b60;
            --primary-light: #1a5c8a;
            --primary-dark: #072a45;
            --accent: #c49a3c;
            --accent-hover: #b0882e;
            --bg: #f4f6f9;
            --bg-dark: #0a1828;
            --text: #2c3e50;
            --text-light: #64748b;
            --white: #ffffff;
            --border: #e2e8f0;
            --shadow-sm: 0 2px 8px rgba(0,0,0,0.04);
            --shadow-md: 0 8px 24px rgba(0,0,0,0.08);
            --shadow-lg: 0 16px 40px rgba(0,0,0,0.12);
            --radius: 8px;
            --font-serif: 'Noto Serif SC', 'SimSun', serif;
            --font-sans: 'Noto Sans SC', -apple-system, BlinkMacSystemFont, 'Microsoft YaHei', sans-serif;
        }

        html { scroll-behavior: smooth; }
        body { font-family: var(--font-sans); color: var(--text); background: var(--bg); line-height: 1.8; overflow-x: hidden; }
        .container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }

        /* ===== 顶部信息栏 ===== */
        .top-bar { background: var(--primary-dark); color: rgba(255,255,255,0.8); font-size: 0.8rem; padding: 8px 0; border-bottom: 1px solid rgba(255,255,255,0.1); }
        .top-bar .container { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; }
        .top-bar-left { display: flex; gap: 20px; flex-wrap: wrap; }
        .top-bar-left span { display: flex; align-items: center; gap: 6px; }
        .top-bar-left i { color: var(--accent); }
        .top-bar-right a { color: rgba(255,255,255,0.8); text-decoration: none; margin-left: 16px; transition: color 0.3s; }
        .top-bar-right a:hover { color: var(--accent); }

        /* ===== 导航栏 ===== */
        .navbar { position: sticky; top: 0; z-index: 1000; background: rgba(255,255,255,0.98); backdrop-filter: blur(12px); border-bottom: 1px solid var(--border); transition: all 0.3s ease; }
        .navbar.scrolled { box-shadow: var(--shadow-md); }
        .nav-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; display: flex; justify-content: space-between; align-items: center; height: 72px; }
        .nav-logo { display: flex; align-items: center; gap: 12px; text-decoration: none; color: var(--primary); }
        .logo-img { width: 48px; height: 48px; border-radius: 50%; object-fit: contain; }
        .logo-text { display: flex; flex-direction: column; }
        .logo-text h1 { font-size: 1.3rem; font-weight: 700; font-family: var(--font-serif); letter-spacing: 2px; line-height: 1.2; }
        .logo-text p { font-size: 0.7rem; color: var(--text-light); letter-spacing: 4px; }
        .nav-menu { display: flex; list-style: none; gap: 8px; }
        .nav-link { text-decoration: none; color: var(--text); font-size: 0.95rem; font-weight: 500; padding: 8px 16px; border-radius: 4px; transition: all 0.3s; }
        .nav-link:hover, .nav-link.active { color: var(--primary); background: rgba(26,92,138,0.06); }
        .hamburger { display: none; flex-direction: column; gap: 5px; cursor: pointer; padding: 8px; }
        .hamburger span { display: block; width: 24px; height: 2px; background: var(--text); transition: all 0.3s; }

        /* ===== 公告滚动条 ===== */
        .notice-bar { background: var(--white); border-bottom: 1px solid var(--border); padding: 12px 0; font-size: 0.9rem; }
        .notice-bar .container { display: flex; align-items: center; gap: 16px; }
        .notice-label { background: var(--accent); color: #fff; padding: 2px 12px; border-radius: 4px; font-size: 0.8rem; font-weight: 600; white-space: nowrap; }
        .notice-content { flex: 1; overflow: hidden; position: relative; height: 24px; }
        .notice-list { position: absolute; top: 0; left: 0; animation: scrollNotice 20s linear infinite; }
        .notice-list:hover { animation-play-state: paused; }
        .notice-list div { height: 24px; line-height: 24px; color: var(--text-light); }
        .notice-list div a { color: var(--text); text-decoration: none; }
        .notice-list div a:hover { color: var(--primary); }
        .notice-list .new-tag { color: #e74c3c; font-size: 0.7rem; border: 1px solid #e74c3c; padding: 0 4px; border-radius: 2px; margin-right: 6px; }
        @keyframes scrollNotice { 0% { transform: translateY(0); } 100% { transform: translateY(-100%); } }

        /* ===== Hero 区（视频开屏，播完切图片） ===== */
        .hero {
            position: relative;
            min-height: 90vh;
            display: flex; align-items: center;
            overflow: hidden;
            background: #000;
            z-index: 1;
        }

        .hero-video {
            position: absolute; inset: 0;
            width: 100%; height: 100%;
            object-fit: cover;
            z-index: -2;
            opacity: 0;
            transition: opacity 1.5s ease;
        }
        .hero-video.loaded { opacity: 1; }
        .hero-video.fade-out { opacity: 0; visibility: hidden; }

        .hero-bg-fallback {
            position: absolute; inset: 0;
            background: url('images/banner.jpg') center/cover no-repeat;
            z-index: -2;
            animation: bgZoom 20s ease-in-out infinite alternate;
            opacity: 0.6;
        }
        @keyframes bgZoom {
            0% { transform: scale(1); }
            100% { transform: scale(1.15); }
        }

        .hero-overlay {
            position: absolute; inset: 0;
            background: linear-gradient(to bottom, rgba(0, 0, 0, 0.75) 0%, rgba(0, 0, 0, 0.2) 50%, rgba(0, 0, 0, 0.8) 100%);
            z-index: -1;
        }

        .hero-spotlight {
            position: absolute; inset: 0; z-index: 0; pointer-events: none;
            background: radial-gradient(circle 400px at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(196, 154, 60, 0.15), transparent 80%);
            transition: background 0.1s ease;
            opacity: 0; transition: opacity 1s ease;
        }

        #particles-canvas { position: absolute; inset: 0; z-index: 0; pointer-events: none; opacity: 0; transition: opacity 1s ease; }

        .hero .container {
            position: relative; z-index: 2;
            width: 100%;
            display